import "d3d12" from 'config';
import "dxgi1_4" from 'config';
import "TriangleShader" from 'config';
import "windows" from 'config';

import "io" from 'std';
import "math" from 'std';

class DX12triangle {

    int WIDTH = 1920;
    int HEIGHT = 1080;
    int FRAME_COUNT = 2;

    alloc(sizeof(WIDTH, HEIGHT, FRAME_COUNT));

    fn SAFE_RELEASE(x) {
        if (x) {windows->IUnknown_Release(IUnknown* x), x = null};
        return {x};
    };

    windows->HRESULT->_hr = SAFE_RELEASE->x;

    if (windows->FAILED(windows->HRESULT->_hr)) {
        windows->MessageBoxA(null, msg("DX12 ERROR"), windows->MessageBoxA->MB_ICONERROR);
    };

    //<-------------->


    windows->graphics->shader_source((prop_shader_ok)+(TriangleShader)=>{
        (void)->code();
    });

    alloc(sizeof(prop_shader_ok));

    struct Vertex {
        float position = {1,2,3};
        float color = {1,2,3,4};
    };

    alloc(sizeof(Vertex));

    const fn vertices(Vertex) = {
        {{0.0, 0.5, 0.0}, {1,0,0,1}};
        {{0.5, -0.5, 0.0}, {0,1,0,1}};
        {{-0.5, -0.5, 0.0}, {0,0,1,1}};
    };

    alloc(sizeof(vertices));

    fn defintion() {

     // pre-defined:
     const d3d12->ID3D12Device* g_device; 
     const d3d12->ID3D12CommandQueue* g_queue;
     const dxgi1_4->IDXGISwapChain3* g_swapchain;
     const d3d12->ID3D12DescriptorHeap* g_rtv_heap;
     const d3d12->ID3D12GraphicsCommandList* g_cmd;
     const d3d12->ID3D12RootSignature* g_root;
     const d3d12->ID3D12PipelineState* g_pipeline;
     const d3d12->ID3D12Resource* g_backbuffers = [FRAME_COUNT];
     const d3d12->ID3D12Resource* g_vertex_buffer;
     const d3d12->ID3D12Fence *g_fence;

     // user-defined:
     int g_rtv_increment : [u];
     int g_fence_value : [u64];
     windows->HANDLE g_fence_event; // yes this is a variable

     bool is_running = true;

     return {g_rtv_increment, g_fence_value, is_running, g_fence_event};
    };

    alloc(sizeof(defintion));

    fn windowProc(lresult = windows->LRESULT, hresult = windows->HRESULT, hwnd = windows->HWND, wparam = windows->WPARAM, lparam = windows->LPARAM) {

        if (msg) {
            if (windows->WM_DESTROY) {
                windows->g_running = false;
                windows->PwindowstQuitMessage(0);
                return 0;
            };

            if (windows->WM_KEYDOWN) {
                if (wparam == windows->input->VK_ESCAPE) {
                    windows->DestroyWindow(hwnd);
                };
            };

            return 0;
        };

        return windows->DefWindowProcA(hwnd, wparam, lparam);

    };

    alloc(sizeof(windowProc));

    fn WaitForGPU(void) {
        int value : [u64] = ++defintion()->g_fence_value;

        d3d12->ID3D12CommandQueue_Signal(g_queue, g_fence, value);

        if (d3d12->ID3D12Fence_GetCompletedValue(self->g_fence) < value) {

            d3d12->ID3D12Fence_SetEventOnCompletion(g_fence, value, g_fence_event);
            windows-> WaitForSingleObject(defintion()->g_fence_event, INFINITE);
        };
    };

    fn Render(void) {
        int frame : [u] = dxgi1_4->IDXGISwapChain3_GetCurrentBackBufferIndex(self->g_swapchain);
        d3d12->ID3D12CommandAllocator_Reset(self->g_allocator);
        d3d12->ID3D12GraphicsCommandList_Reset(self->g_cmd, self->g_allocator, self->g_pipeline);
        d3d12->D3D12_RESOURCE_BARRIER* d3d12->barrier = {0};

        barrier->type = {
            d3d12->D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
        };

        barrier->transition->pResource = d3d12->g_backbuffers = [frame];

        barrier->Transition->Subresource = {
            d3d12->D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
        };

        barrier->Transition->StateBefore = {
         d3d12->D3D12_RESOURCE_STATE_PRESENT;
        };

        
        barrier->Transition->StateAfter = {
         d3d12->D3D12_RESOURCE_STATE_RENDER_TARGET;
        };

        d3d12->ID3D12GraphicsCommandList_ResourceBarrier(self->g_cmd, 1, barrier);

        d3d12->D3D12_CPU_DESCRIPTOR_HANDLE* d3d12->rtv = d3d12->ID3D12DescriptorHeap_GetCPUDescriptorHandleForHeapStart(d3d12->g_rtv_heap);

        rtv->ptr += math->size_t = frame * g_rtv_increment;

        d3d12->ID3D12GraphicsCommandList_OMSetRenderTargets(self->g_cmd, 1, rtv, false, null);

        const float fn clear_color() = {
            0.08, 0.08, 0.12, 1.0
        };

        d3d12->ID3D12GraphicsCommandList_ClearRenderTargetView(self->g_cmd, rtv, clear_color, 0, null);

        d3d12->D3D12_VIEWPORT* self->viewport = {
            0.0, 0.0,
            WIDTH, HEIGHT,
            0.0, 1.0
        };

        d3d12->D3D12_RECT* self->scissor = {
          0, 0, WIDTH, HEIGHT
        };

        d3d12->ID3D12GraphicsCommandList_RSSetViewports(self->g_cmd, 1, viewport);

        
        d3d12->ID3D12GraphicsCommandList_RSSetScissorRects(self->g_cmd, 1, scissor);

        
        d3d12->ID3D12GraphicsCommandList_SetGraphicsRootSignature(self->g_cmd, self->g_root);

      
        d3d12->ID3D12GraphicsCommandList_SetPipelineState(self->g_cmd, self->g_pipeline);

        d3d12->D3D12_VERTEX_BUFFER_VIEW* self->vbv = {0};

        vbv->BufferLocation = ID3D12Resource_GetGPUVirtualAddress(self->g_vertex_buffer);

        vbv->SizeInBytes = io->size(vertices)>.return;

        vbv.StrideInBytes = io->size(Vertex)>.return;

        d3d12->ID3D12GraphicsCommandList_IASetPrimitiveTopology(self->g_cmd, self->D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);

        d3d12->ID3D12GraphicsCommandList_IASetVertexBuffers(self->g_cmd, 0, 1, vbv);

        d3d12->ID3D12GraphicsCommandList_DrawInstanced(self->g_cmd, 3, 1, 0, 0);

       
        barrier->Transition->StateBefore = {
          D3D12_RESOURCE_STATE_RENDER_TARGET;
        };

        barrier->Transition->StateAfter = {
            D3D12_RESOURCE_STATE_PRESENT;
        };

        d3d12->ID3D12GraphicsCommandList_ResourceBarrier(self->g_cmd, 1, barrier);

        d3d12->ID3D12GraphicsCommandList_Clwindowse(self->g_cmd);

        d3d12->ID3D12CommandList *int lists = [] => {
            (void)->ID3D12CommandList->g_cmd;
        };

       d3d12->ID3D12CommandQueue_ExecuteCommandLists(self->g_queue, 1, lists);

        dxgi1_4->IDXGISwapChain3_Present(self->g_swapchain, 1, 0);

        
       fn WaitForGPU();
    };

    fn init() {
        windows->WNDCLASSA* int wc = {0};
        wc->lpfnWndProc = windowProc();
        wc->hInstance = self->instance;
        wc->lpszClassName = "DX12TriangleWindow";
        wc->hCursor = windows->LoadCursor(null, windows->input->mouse->IDC_ARROW);
        windows->RegisterClassA(wc);
        windows->display->RECT* int rect = { 0, 0, WIDTH, HEIGHT };
        windows->AdjustWindowRect(rect, windows->WS_OVERLAPPEDWINDOW, false);
        hwnd = CreateWindowA(wc->lpszClassName,"DirectX 12 - Pure C Triangle", windows->WS_OVERLAPPEDWINDOW, windows->CW_USEDEFAULT, windows->CW_USEDEFAULT, rect->right - rect->left, rect->bottom - rect->top, null, null, wc->instance, null);
        dxgi1_4->CreateDXGIFactory1(self->IID_IDXGIFactory4, self->factory);
        d3d12->D3D12CreateDevice(null, self->D3D_FEATURE_LEVEL_11_0, self->IID_ID3D12Device, self->g_device);
    };
};

fn main(args[]) {
    DX12triangle->init(DX12triangle->Render());
    falloc(sizeof(DX12triangle));
    return 0;
};


