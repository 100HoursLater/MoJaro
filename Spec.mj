import "io" from 'std';
import "text" from 'std';
import "serial" from 'std';
import "ui" from 'std';
import "http" from 'std';
import "pattern" from 'std';
import "web" from 'std';

fn main(args[]) {
    io->print(msg,"Hello, World");
    return 0;
}

// operators 
= // assignment
== // comparison>
+ // addition
- // subtraction 
* // multiply 
/ // division 
> // more than
< // less than
>= // more than equals 
<= // less than equals 

&& // Boolean AND
& // Bitwise AND 

|| // Boolean OR
| // Bitwise OR 

% // modulo 
-> // casual/access pointer 
! // negate 
++ // increment
-- // decrement
self // self always points to the immediate construct you are currently inside.

class MyClass : private {} // file level access of this class 

class myClass : public {} // exported and accessible (similar to import system of JS/TS)

struct MyStruct : private {} // file level access of this struct 

struct myStruct : public {} // exported and accessible 

// inheritence 

class MyNewClass->MyClass {

}

// property structs
// anonymous/global
struct I* Property(=>{
  (void)->/*some value and operation*/;
});

// can only change the values of MyClass
struct K* Property((MyClass)=>{
  (void)->/*Some value and operation*/;
});

// name property struct 
struct O* Property((Prop_Name)+(MyClass)=>{
  (void)->/*Some value and operation*/;
});

// lambdas 

int x = 10; 
int y = 5;

// anon lambda
fn->(x => y * x) // this does not have the >.return modifier 

// from class 
class U {
    int i = 9;
    int o = 8;
    int u = 10;
}->(i => o * u)>.return; // boom, the lambdas return value is now part of class U

U->lambda_0; // default indexing of class lambda is 0 

// from function 

fn Y() {
    int q = 7;
    int w = 5; 
    int e = 4;
}->(q => w + e)>.return;

Y()->lambda_0; 

// all classes and functions have a quick access to their return value 
U>.return; // that returns the whole of U's return value which is useful in cases like:

int P = U>.return; // U's return value flows into int P

// pointers and SMMM (Smart Manual Memory Management)

// causal pointers are equivalent to dot-notation or double colon, it's just the access pattern

// SMMM pointers are different (suffix '*'), they denote a memory share (part of the Product/Property Model)

U* O; // this operation shares U's memory with struct O, which is a conflict of memory (where spaces allocate)

alloc(sizeof(/*class, function or variable*/)); // this bumps the pointer (MoJaro uses a linear allocator for it's memory)
falloc(sizeof(/*class, function or variable*/)); // this is a targeted missile strike
return 0; // this exits the application as successful
return -1; // this exits the application as a failed

// variables

int // 16 bit int
float // 32 bit float
double // 64 bit float
char // single character
string // string 
bool // boolean

// but MoJaro makes specific variables like integers and strings variable 
// explicit bit-width

int v : [32] = 10; // 32 bit integer 
int n : [64] = 9; // 64 bit integer
int m : [128] = 11; // 128 bit integer 

string f : [] = "I love It" // the compiler automatically fills that length array with your text, since a string variable is just a fancy long char

// constant variables 

const int // 16 bit int that cannot be changed

const float 

const double 

const char 

const string 

const bool 

const int W : [32] = 111;
const int H : [64] = 222; 
const int Y : [128] = 333;
// text specificity 

f->replace('I', "Penis"); // this replaces the first instance of 'I' in the whole string with penis
f->replaceAll('l', "IOU");
f->regexp(const string = [/cdbfg/]->()=>{
  if (f contains string) {
    f->delete(string); // this gets rid of all of those characters if you want to get rid of words
    f->delete_w(string); // now it deletes any word with those characters.
  }
});

// all strings have text based operations including at 

if ("fuck" == f->at(-1)) {
    throw errno_t; 
    io->err(msg, "NO SWEARING!!!");
    f->replaceAll('fuck', "f***");
}; // as an example

// for loops
// new var
for(int x = 0; x < 10; x++) {
 // do something
};

// existing var
for(v; v < 9; v++) {
    // do something
};

// alloc vs falloc

alloc(sizeof(Y, O, U)); // a function, struct and class now occupy the arena 

falloc(sizeof(Y, O, U)); // this clears those pointers from memory and puts a free sign on their previous spots in the arena. 

// memory in more detail
// MoJaro uses non shared memory arena, each thread spawns it's own. 
// serialisation between functions
// when a construct, class, function or variable is falloc'd, pointers going to it's memory address are killed to prevent use-after-free

fn MyInFileFunction() {
  // do something
};

serial->encode(int array_1 : [64] = [MyInFileFunction()>.return;], int array_2 : [64] = [MyExternalFunction()>.return;]>()=>{
  serial->share(array_1 + array_2);
  serial->decode(=>{
     if (!array_1 || array_1 == null) {
       falloc(sizeof(array_1));
     };
     if (!array_2 || array_2 == null) {
       falloc(sizeof(array_2));
     };
  });
});


// http
fn MyResponseFunction(int req = http->request(MyResponseFunction), match = pattern->match()) {
 match req->uri()->path()>(http->response && self->result)=>{
   "/" = req->requestIndex(req,0);
   "/foo" = req->requestIndex(req,1), fn foo(req);
   "/bar" = req->requestIndex(req,2), fn bar(req);
   
   alloc(sizeof(foo, bar, req)); 
 };

};

fn addServerHeaders(int response = http->response()) {
  response->headers()* MyResponseFunction()->req(); // these two will now share the same region memory
  response->insert(self->CONTENT, self->HeaderValue("text/html"));
  http->status();
  return self->status;
  alloc(sizeof(addServerHeaders));

  fn checkCode() {
   addServerHeaders()->status = http->StatusCode->OK;
  }
};

// ui

fn MyAppUI(int myUi = ui()) {
  myUi->box((const string name_0)=>{
   self->box_size[100%];
   self->max_screen_size[1920,1080];
   self->min_screen_size[256,144];
   self->box_color[ #ffffff];
   self->box_is_hittable = false;
   self->global_font_family(impact, sans_serif);
   self->global_font_size[26];

   myUi->button(self->size[50%], self->position[left], self->inst_name(const string name = "MyButton1")>(name)=>{

    self->button_is_hittable = true; 
    self->button_action = web()->sendTo(msg,'https://www.google.com'); 
    self->hover_action = self->button_shadow(self->drop[40], self->color[ #000000]), self->tooltip(msg,"I am a google button");
    self->button_text_front(msg, name, "BUTTON");
    alloc(sizeof(name));
   });
   alloc(sizeof(name_0));
  });
  
}

// arrays 
int my_arr_0 : [8] = [1,2,3]; // an array of 8-bit integers 
int my_arr_1 = [1,2,3]; // an array of 16-bit integers 
int my_arr_2 : [32] = [1,2,3]; // an array of 32-bit integers
int my_arr_3 : [64] = [1,2,3]; // an array of 64-bit integers
int my_arr_4 : [128] = [1,2,3]; // an array of 128-bit integers

