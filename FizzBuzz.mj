import "io" from 'std';

fn FizzBuzz() {
    for(int i = 1; i <= 100; i++) {
           alloc(sizeof(i));
        if (i % 3 == 0 && i % 5 == 0) {
            io->print(msg,"FizzBuzz\n");
        } else if (i % 3 == 0) {
            io->print(msg,"Fizz\n");
        } else if (i % 5 == 0) {
            io->print(msg,"Buzz\n");
        } else {
            io->print(msg,i);
        };
        return i;
    };
    falloc(sizeof(i));
    return 0;
};
